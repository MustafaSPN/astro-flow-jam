# ---------------------------------------------------------------
# Astro Flow Jam: repository root .gitignore
# ---------------------------------------------------------------

# ---- macOS / editors -------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
.vs/
.vscode/
.idea/
*.swp
*~

# ---- Unity (project lives in unity/) ----------------------------
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/Assets/AssetStoreTools*
/unity/Assets/StreamingAssets/aa*
# IDE projects generated by Unity
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/*.unityproj
/unity/*.pidb
/unity/*.booproj
/unity/*.user
/unity/*.userprefs
*.pidb.meta
*.pdb.meta
*.mdb.meta
# Crash reports / build artifacts
sysinfo.txt
*.apk
*.aab
*.ipa
*.unitypackage
*.app
crashlytics-build.properties
/unity/Assets/Plugins/Editor/JetBrains*

# ---- iOS / Xcode -------------------------------------------------
*.xcarchive
*.dSYM
*.dSYM.zip
DerivedData/
xcuserdata/
Pods/

# ---- Secrets and per-developer config ---------------------------
# Firebase iOS config: download your own from the Firebase console.
GoogleService-Info.plist
GoogleService-Info.plist.meta
google-services.json
google-services.json.meta
*.p8
*.p12
*.mobileprovision
*.keystore
.env
.env.*

# ---- Third-party SDK tarballs (too big for git) ------------------
# Firebase Unity SDK 14.1.0 .tgz files; see README "Building".
/unity/GooglePackages/

# ---- Level designer (Python) ------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Level designer (Python): the code is public; its market-research inputs and generated output are not.
# Generated levels, pictures and logs (~2 GB, rebuilt by the pipeline)
/unity/Tools/leveldesigner/out/
# Third-party reference data used for calibration, and the scripts that build it
/unity/Tools/leveldesigner/data/
/unity/Tools/leveldesigner/analysis/
# Internal notes; the root README documents the tool
/unity/Tools/leveldesigner/README.md

# ---- Not part of the public repository --------------------------
# Market research material (third-party data)
/research/
# Uploaded App Store archives (contain dSYMs)
/releases/

# Zipped duplicates of extracted art folders
/art/**/*.zip
